# ==============================================================================
# OrbisERP AI Layer — Environment Configuration Template (.env.example)
# ==============================================================================
# NOTICE:
# - This template contains PLACEHOLDERS ONLY.
# - Copy this file to .env and insert your real local credentials.
# - Never commit real secrets or the .env file to git.
# ==============================================================================

# ERPNext Integration (Server-side REST)
ERPNEXT_BASE_URL=http://localhost:8085
ERPNEXT_API_KEY=your_erpnext_api_key_here
ERPNEXT_API_SECRET=your_erpnext_api_secret_here

# LLM Provider Configuration ("auto" uses Groq cloud first, falls back to Ollama local)
LLM_PROVIDER=auto

# Groq Cloud LLM (Server-side only)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama LLM Service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Orbis Voice & Runtime Environment
ORBIS_ENV=development
ORBIS_VOICE_SIMILARITY_THRESHOLD=0.75

# Service Host & Port
AI_SERVICE_NAME=OrbisERP AI Layer
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
DEBUG=false

# Allowed Frontend Origins (CORS)
CORS_ORIGINS=["http://localhost:8085","http://127.0.0.1:8085"]

# Test Scope Restriction
AI_ALLOWED_USER=administrator@example.com
AI_DEFAULT_MODULE=Stock
